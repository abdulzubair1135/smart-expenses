<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/bg_card"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="12dp">

    <!-- Category Icon Avatar -->
    <FrameLayout
        android:id="@+id/fl_icon_bg"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="@drawable/ic_launcher_foreground"
        android:backgroundTint="#FEE2E2">

        <ImageView
            android:id="@+id/iv_tx_icon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="center"
            android:src="@android:drawable/ic_menu_agenda"
            app:tint="@color/financial_expense" />
    </FrameLayout>

    <!-- Details: Description and Category / Time -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_tx_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Food"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_tx_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Food • Expense • Today, 12:30 PM"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Transaction Amount with Colored Sign -->
    <TextView
        android:id="@+id/tv_tx_amount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="- ₹ 250"
        android:textColor="@color/financial_expense"
        android:textSize="16sp"
        android:textStyle="bold" />

</LinearLayout>
