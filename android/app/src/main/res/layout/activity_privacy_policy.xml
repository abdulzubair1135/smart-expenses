<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_main">

    <!-- Header App Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="16dp"
        android:paddingBottom="12dp"
        android:background="@color/bg_card"
        android:elevation="2dp">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_back"
            app:tint="@color/text_primary"
            android:contentDescription="Go Back" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Privacy Policy"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Version 2026.1 • Effective October 2026"
                android:textSize="11sp"
                android:textColor="@color/text_secondary" />
        </LinearLayout>
    </LinearLayout>

    <!-- Scrollable Content -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="24dp"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Privacy Commitment Banner -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="#EFF6FF"
                app:cardCornerRadius="14dp"
                app:cardElevation="0dp"
                app:strokeWidth="1dp"
                app:strokeColor="#3B82F6">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="16dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Our Privacy Commitment"
                        android:textStyle="bold"
                        android:textColor="#1D4ED8"
                        android:textSize="14sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="Smart Expenses Tracker is built on a local-first architecture. Your personal transaction records reside in an encrypted/isolated SQLite database on your device and are never sold or used for ad targeting."
                        android:textColor="@color/text_primary"
                        android:textSize="12.5sp"
                        android:lineSpacingExtra="3dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 1. Introduction -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1. Introduction"
                android:textStyle="bold"
                android:textSize="15sp"
                android:textColor="@color/text_primary" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="14dp"
                android:text="This Privacy Policy explains how Smart Expenses Tracker collects, uses, and safeguards information when you use our Android mobile application and local financial services."
                android:textSize="13sp"
                android:textColor="@color/text_secondary"
                android:lineSpacingExtra="3dp" />

            <!-- 2. Information the App Collects -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="2. Information the App Collects"
                android:textStyle="bold"
                android:textSize="15sp"
                android:textColor="@color/text_primary" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="14dp"
                android:text="We collect only information essential to personal expense accounting, consisting primarily of data you directly input."
                android:textSize="13sp"
                android:textColor="@color/text_secondary"
                android:lineSpacingExtra="3dp" />

            <!-- 3. Information the User Enters -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="3. Information You Enter"
                android:textStyle="bold"
                android:textSize="15sp"
                android:textColor="@color/text_primary" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="14dp"
                android:text="When managing your expenses, you enter transaction titles, descriptions, expense amounts, account categories, and savings goal targets."
                android:textSize="13sp"
                android:textColor="@color/text_secondary"
                android:lineSpacingExtra="3dp" />

            <!-- 4. Financial Transaction Information -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="4. Financial Transaction Information"
                android:textStyle="bold"
                android:textSize="15sp"
                android:textColor="@color/text_primary" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="14dp"
                android:text="Transaction figures are stored in 64-bit integer minor units (paise) locally on your device to guarantee numerical precision and avoid rounding errors."
                android:textSize="13sp"
                android:textColor="@color/text_secondary"
                android:lineSpacingExtra="3dp" />

            <!-- 5. Account and Authentication Information -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="5. Account and Authentication Information"
                android:textStyle="bold"
                android:textSize="15sp"
                android:textColor="@color/text_primary" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="14dp"
                android:text="Registration requires a display name, email, and password. Passwords are never logged or stored as plaintext."
                android:textSize="13sp"
                android:textColor="@color/text_secondary"
                android:lineSpacingExtra="3dp" />

            <!-- 6. Local Database Storage -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="6. Local Database Storage"
                android:textStyle="bold"
                android:textSize="15sp"
                android:textColor="@color/text_primary" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="14dp"
                android:text="All active account records reside primarily in an offline Room SQLite database (`smart_expenses_db`) located in private app sandbox storage on your device."
                android:textSize="13sp"
                android:textColor="@color/text_secondary"
                android:lineSpacingExtra="3dp" />

            <!-- 7. Backend Data Processing -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="7. Backend Data Processing"
                android:textStyle="bold"
                android:textSize="15sp"
                android:textColor="@color/text_primary" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="14dp"
                android:text="When online synchronization is used, transaction payloads are sent to our authenticated Express API service with user ID token isolation."
                android:textSize="13sp"
                android:textColor="@color/text_secondary"
                android:lineSpacingExtra="3dp" />

            <!-- 8. Synchronization -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="8. Synchronization &amp; Offline Queues"
                android:textStyle="bold"
                android:textSize="15sp"
                android:textColor="@color/text_primary" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="14dp"
                android:text="Transactions created offline are queued with unique idempotency keys so that no record is duplicated upon reconnecting."
                android:textSize="13sp"
                android:textColor="@color/text_secondary"
                android:lineSpacingExtra="3dp" />

            <!-- 9. Device Permissions -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="9. Device Permissions"
                android:textStyle="bold"
                android:textSize="15sp"
                android:textColor="@color/text_primary" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="14dp"
                android:text="The app requests: INTERNET (for optional sync), ACCESS_NETWORK_STATE (to monitor offline mode), and RECORD_AUDIO (solely for optional voice transaction parsing)."
                android:textSize="13sp"
                android:textColor="@color/text_secondary"
                android:lineSpacingExtra="3dp" />

            <!-- 10. Analytics and Diagnostics -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="10. Analytics and Diagnostics"
                android:textStyle="bold"
                android:textSize="15sp"
                android:textColor="@color/text_primary" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="14dp"
                android:text="We do not deploy third-party advertising trackers or invasive behavioral spyware. Error monitoring is limited to local diagnostic logs."
                android:textSize="13sp"
                android:textColor="@color/text_secondary"
                android:lineSpacingExtra="3dp" />

            <!-- 11. Third-Party Services -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="11. Third-Party Services"
                android:textStyle="bold"
                android:textSize="15sp"
                android:textColor="@color/text_primary" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="14dp"
                android:text="No financial information is transferred to advertisers, brokers, or marketing networks."
                android:textSize="13sp"
                android:textColor="@color/text_secondary"
                android:lineSpacingExtra="3dp" />

            <!-- 12. Data Sharing -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="12. Data Sharing"
                android:textStyle="bold"
                android:textSize="15sp"
                android:textColor="@color/text_primary" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="14dp"
                android:text="We do not sell, rent, or trade your personal or financial records under any circumstances."
                android:textSize="13sp"
                android:textColor="@color/text_secondary"
                android:lineSpacingExtra="3dp" />

            <!-- 13. Data Retention -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="13. Data Retention"
                android:textStyle="bold"
                android:textSize="15sp"
                android:textColor="@color/text_primary" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="14dp"
                android:text="Your records are retained on your device for as long as the application remains installed, or until you explicitly delete transactions."
                android:textSize="13sp"
                android:textColor="@color/text_secondary"
                android:lineSpacingExtra="3dp" />

            <!-- 14. Account Deletion -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="14. Account Deletion"
                android:textStyle="bold"
                android:textSize="15sp"
                android:textColor="@color/text_primary" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="14dp"
                android:text="You may reset or clear your account records at any time from within Settings or by clearing application storage in Android system settings."
                android:textSize="13sp"
                android:textColor="@color/text_secondary"
                android:lineSpacingExtra="3dp" />

            <!-- 15. Data Export Options -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="15. Data Export &amp; Backup"
                android:textStyle="bold"
                android:textSize="15sp"
                android:textColor="@color/text_primary" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="14dp"
                android:text="You have full ownership of your data and can view all itemized transactions on the Activity history screen."
                android:textSize="13sp"
                android:textColor="@color/text_secondary"
                android:lineSpacingExtra="3dp" />

            <!-- 16. Data Security -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="16. Data Security"
                android:textStyle="bold"
                android:textSize="15sp"
                android:textColor="@color/text_primary" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="14dp"
                android:text="We implement Android sandbox permissions, token validation headers, and local SQLite data isolation to protect your records."
                android:textSize="13sp"
                android:textColor="@color/text_secondary"
                android:lineSpacingExtra="3dp" />

            <!-- 17. User Choices -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="17. User Choices"
                android:textStyle="bold"
                android:textSize="15sp"
                android:textColor="@color/text_primary" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="14dp"
                android:text="You choose which accounts, categories, and transactions to record, and whether to use voice-based entry."
                android:textSize="13sp"
                android:textColor="@color/text_secondary"
                android:lineSpacingExtra="3dp" />

            <!-- 18. Children's Privacy -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="18. Children's Privacy"
                android:textStyle="bold"
                android:textSize="15sp"
                android:textColor="@color/text_primary" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="14dp"
                android:text="Smart Expenses Tracker does not knowingly collect personal information from children under 13."
                android:textSize="13sp"
                android:textColor="@color/text_secondary"
                android:lineSpacingExtra="3dp" />

            <!-- 19. Policy Changes -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="19. Policy Changes"
                android:textStyle="bold"
                android:textSize="15sp"
                android:textColor="@color/text_primary" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="14dp"
                android:text="Any updates to this privacy policy will be updated with a revised effective date and published in the application."
                android:textSize="13sp"
                android:textColor="@color/text_secondary"
                android:lineSpacingExtra="3dp" />

            <!-- 20. Contact Information -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="20. Contact Information"
                android:textStyle="bold"
                android:textSize="15sp"
                android:textColor="@color/text_primary" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="14dp"
                android:text="For questions regarding this policy or data privacy, reach out to the project authors at [privacy@smarttracker.local]."
                android:textSize="13sp"
                android:textColor="@color/text_secondary"
                android:lineSpacingExtra="3dp" />

            <!-- 21. Effective Date -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="21. Effective Date"
                android:textStyle="bold"
                android:textSize="15sp"
                android:textColor="@color/text_primary" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="24dp"
                android:text="Effective as of October 13, 2026. Version 2026.1."
                android:textSize="13sp"
                android:textColor="@color/text_secondary"
                android:lineSpacingExtra="3dp" />

        </LinearLayout>
    </ScrollView>
</LinearLayout>
