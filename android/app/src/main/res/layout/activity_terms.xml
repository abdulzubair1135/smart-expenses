<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_main">

    <!-- Header App Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="16dp"
        android:paddingBottom="12dp"
        android:background="@color/bg_card"
        android:elevation="2dp">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_back"
            app:tint="@color/text_primary"
            android:contentDescription="Go Back" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Terms &amp; Conditions"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Version 2026.1 • Effective October 2026"
                android:textSize="11sp"
                android:textColor="@color/text_secondary" />
        </LinearLayout>
    </LinearLayout>

    <!-- Scrollable Content -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="24dp"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Intro Banner Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="@color/brand_primary_light"
                app:cardCornerRadius="14dp"
                app:cardElevation="0dp"
                app:strokeWidth="1dp"
                app:strokeColor="@color/brand_primary">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="16dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Personal Expense Management Tool"
                        android:textStyle="bold"
                        android:textColor="@color/brand_primary_dark"
                        android:textSize="14sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="Smart Expenses Tracker is an offline-first personal financial record utility. This application is not a bank, banking agent, or financial institution. Please review the following terms carefully."
                        android:textColor="@color/text_primary"
                        android:textSize="12.5sp"
                        android:lineSpacingExtra="3dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Section 1 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1. Introduction"
                android:textStyle="bold"
                android:textSize="15sp"
                android:textColor="@color/text_primary" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="14dp"
                android:text="Welcome to Smart Expenses Tracker. These Terms &amp; Conditions govern your access to and use of our mobile application, local database storage, and associated backend synchronization services."
                android:textSize="13sp"
                android:textColor="@color/text_secondary"
                android:lineSpacingExtra="3dp" />

            <!-- Section 2 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="2. Acceptance of Terms"
                android:textStyle="bold"
                android:textSize="15sp"
                android:textColor="@color/text_primary" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="14dp"
                android:text="By checking the agreement box during registration or using the application, you agree to be bound by these terms. If you do not agree, do not install or use the app."
                android:textSize="13sp"
                android:textColor="@color/text_secondary"
                android:lineSpacingExtra="3dp" />

            <!-- Section 3 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="3. Eligibility"
                android:textStyle="bold"
                android:textSize="15sp"
                android:textColor="@color/text_primary" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="14dp"
                android:text="You must be at least 13 years old (or the legal age of majority in your jurisdiction) to use Smart Expenses Tracker."
                android:textSize="13sp"
                android:textColor="@color/text_secondary"
                android:lineSpacingExtra="3dp" />

            <!-- Section 4 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="4. Account Registration"
                android:textStyle="bold"
                android:textSize="15sp"
                android:textColor="@color/text_primary" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="14dp"
                android:text="When creating an account, you agree to provide truthful and accurate information. Each user is responsible for maintaining the confidentiality of their credentials."
                android:textSize="13sp"
                android:textColor="@color/text_secondary"
                android:lineSpacingExtra="3dp" />

            <!-- Section 5 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="5. Account Security"
                android:textStyle="bold"
                android:textSize="15sp"
                android:textColor="@color/text_primary" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="14dp"
                android:text="You are solely responsible for all activity conducted through your device and account. If you suspect unauthorized access, log out immediately and reset your password."
                android:textSize="13sp"
                android:textColor="@color/text_secondary"
                android:lineSpacingExtra="3dp" />

            <!-- Section 6 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="6. Personal Financial Records"
                android:textStyle="bold"
                android:textSize="15sp"
                android:textColor="@color/text_primary" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="14dp"
                android:text="All transaction records, account balances, and savings goals stored in this app represent manual user entries. The app does not connect directly to banking clearing networks."
                android:textSize="13sp"
                android:textColor="@color/text_secondary"
                android:lineSpacingExtra="3dp" />

            <!-- Section 7 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="7. Accuracy of User-Entered Information"
                android:textStyle="bold"
                android:textSize="15sp"
                android:textColor="@color/text_primary" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="14dp"
                android:text="Financial calculations are calculated in integer minor units (paise in INR) based on user-entered amounts. You are responsible for verifying your entries."
                android:textSize="13sp"
                android:textColor="@color/text_secondary"
                android:lineSpacingExtra="3dp" />

            <!-- Section 8 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="8. Local Data Storage"
                android:textStyle="bold"
                android:textSize="15sp"
                android:textColor="@color/text_primary" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="14dp"
                android:text="This application uses a local Room SQLite database on your device. Clearing app storage or uninstalling the app may permanently remove local data unless synced."
                android:textSize="13sp"
                android:textColor="@color/text_secondary"
                android:lineSpacingExtra="3dp" />

            <!-- Section 9 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="9. Synchronization and Connectivity"
                android:textStyle="bold"
                android:textSize="15sp"
                android:textColor="@color/text_primary" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="14dp"
                android:text="Cloud synchronization is optional and requires an active internet connection. Offline transactions are queued locally with idempotency keys."
                android:textSize="13sp"
                android:textColor="@color/text_secondary"
                android:lineSpacingExtra="3dp" />

            <!-- Section 10 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="10. Responsible Use"
                android:textStyle="bold"
                android:textSize="15sp"
                android:textColor="@color/text_primary" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="14dp"
                android:text="You agree to use this application exclusively for lawful personal financial budgeting and tracking purposes."
                android:textSize="13sp"
                android:textColor="@color/text_secondary"
                android:lineSpacingExtra="3dp" />

            <!-- Section 11 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="11. Prohibited Activities"
                android:textStyle="bold"
                android:textSize="15sp"
                android:textColor="@color/text_primary" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="14dp"
                android:text="You may not reverse-engineer, decompile, or attempt to disrupt the application or its local databases. Automated scraping or denial of service attacks are strictly prohibited."
                android:textSize="13sp"
                android:textColor="@color/text_secondary"
                android:lineSpacingExtra="3dp" />

            <!-- Section 12 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="12. Data Loss and Backup Limitations"
                android:textStyle="bold"
                android:textSize="15sp"
                android:textColor="@color/text_primary" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="14dp"
                android:text="While the application incorporates robust SQLite transaction safety, you are encouraged to maintain backups of important financial figures. We are not liable for accidental hardware loss."
                android:textSize="13sp"
                android:textColor="@color/text_secondary"
                android:lineSpacingExtra="3dp" />

            <!-- Section 13 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="13. Service Availability"
                android:textStyle="bold"
                android:textSize="15sp"
                android:textColor="@color/text_primary" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="14dp"
                android:text="The application is provided on an 'as-is' and 'as-available' basis. We reserve the right to modify or discontinue features with appropriate notification."
                android:textSize="13sp"
                android:textColor="@color/text_secondary"
                android:lineSpacingExtra="3dp" />

            <!-- Section 14 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="14. Third-Party Services"
                android:textStyle="bold"
                android:textSize="15sp"
                android:textColor="@color/text_primary" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="14dp"
                android:text="Any third-party libraries or services (such as Android SpeechRecognizer or SQLite) operate under their respective vendor terms."
                android:textSize="13sp"
                android:textColor="@color/text_secondary"
                android:lineSpacingExtra="3dp" />

            <!-- Section 15 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="15. Intellectual Property"
                android:textStyle="bold"
                android:textSize="15sp"
                android:textColor="@color/text_primary" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="14dp"
                android:text="All graphics, code, architecture, and brand assets of Smart Expenses Tracker remain the intellectual property of the project developers."
                android:textSize="13sp"
                android:textColor="@color/text_secondary"
                android:lineSpacingExtra="3dp" />

            <!-- Section 16 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="16. Limitation of Liability"
                android:textStyle="bold"
                android:textSize="15sp"
                android:textColor="@color/text_primary" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="14dp"
                android:text="In no event shall the authors or project owners be liable for any direct, indirect, incidental, or consequential damages resulting from your use of this tracking tool."
                android:textSize="13sp"
                android:textColor="@color/text_secondary"
                android:lineSpacingExtra="3dp" />

            <!-- Section 17 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="17. Changes to Terms"
                android:textStyle="bold"
                android:textSize="15sp"
                android:textColor="@color/text_primary" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="14dp"
                android:text="We may update these terms periodically. Continuing to use the app following updates signifies your acceptance of the revised terms."
                android:textSize="13sp"
                android:textColor="@color/text_secondary"
                android:lineSpacingExtra="3dp" />

            <!-- Section 18 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="18. Termination of Access"
                android:textStyle="bold"
                android:textSize="15sp"
                android:textColor="@color/text_primary" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="14dp"
                android:text="We reserve the right to suspend or terminate account access if a user violates these terms or engages in malicious activities."
                android:textSize="13sp"
                android:textColor="@color/text_secondary"
                android:lineSpacingExtra="3dp" />

            <!-- Section 19 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="19. Contact Information"
                android:textStyle="bold"
                android:textSize="15sp"
                android:textColor="@color/text_primary" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="14dp"
                android:text="For questions regarding these terms, please contact the development team at [support@smarttracker.local]."
                android:textSize="13sp"
                android:textColor="@color/text_secondary"
                android:lineSpacingExtra="3dp" />

            <!-- Section 20 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="20. Effective Date"
                android:textStyle="bold"
                android:textSize="15sp"
                android:textColor="@color/text_primary" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="24dp"
                android:text="These terms are effective as of October 13, 2026. Version 2026.1."
                android:textSize="13sp"
                android:textColor="@color/text_secondary"
                android:lineSpacingExtra="3dp" />

        </LinearLayout>
    </ScrollView>
</LinearLayout>
