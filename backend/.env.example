# SMART EXPENSES TRACKER - BACKEND ENVIRONMENT TEMPLATE

PORT=4000
NODE_ENV=production
CORS_ORIGIN=*

# Supabase Credentials (from Supabase Dashboard -> Project Settings -> API)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Admin Secret
ADMIN_SECRET_KEY=smart-expenses-admin-secret-2026

# Notifications (Optional)
FCM_SERVER_KEY=

# AI Configuration
AI_PROVIDER=default
AI_REQUEST_TIMEOUT_MS=4000
AI_MAX_RETRIES=1
